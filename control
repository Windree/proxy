#!/bin/sh

LOG_TMP=
trap '[ -n "$LOG_TMP" ] && rm -f "$LOG_TMP"' EXIT

CURRENT_DIR=$(cd "$(dirname "$0")" && pwd -P)

case "$1" in
    restart)
        LOG_TMP=$(mktemp)
        
        if ! (cd "$CURRENT_DIR" && docker compose restart "$2") >"$LOG_TMP" 2>&1; then
            cat "$LOG_TMP"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {restart container_name}"
        exit 1
        ;;
esac
